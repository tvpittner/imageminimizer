{
  "name": "airtable-image-minimizer",
  "version": "1.0.0",
  "description": "Airtable image processing service with size reduction, bulk download, and public URLs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node dist/utils/migrate.js",
    "clean": "node dist/jobs/cleanupJob.js"
  },
  "keywords": ["airtable", "image-processing", "miniextension"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "bull": "^4.12.0",
    "redis": "^4.6.11",
    "sharp": "^0.33.1",
    "airtable": "^0.12.2",
    "archiver": "^6.0.1",
    "axios": "^1.6.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "node-cron": "^3.0.3",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
